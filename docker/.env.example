# ============================================================
# AI Agent Platform - Docker 部署环境变量模板
#
# 使用方法：
#   cp .env.example .env      （首次部署执行）
#   然后逐项修改下面的占位值！
#
# ⚠️ 本文件是安全的模板（不含真实密钥），可以提交到 Git；
#    而 .env 含真实密钥，已被 .gitignore 排除，严禁提交。
# ============================================================

# ---------- 数据库 ----------
# PostgreSQL 密码（生产环境必须改为强密码）
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ---------- 安全 ----------
# JWT 签名密钥，生产环境必须替换为随机长串。
# 生成方式：
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=please-change-me-to-a-48-bytes-random-base64-string

# ---------- 默认管理员（seed 初始化用） ----------
# 首次 docker compose up 时由 seed 脚本创建；登录后系统会要求修改密码
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-admin-password
