# ===== 服务器配置 =====
NODE_ENV=development
PORT=3000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:5173

# ===== 数据库（PostgreSQL）=====
# 注意：Windows 上已有 postgres:5432 / redis:6379 在跑（系统服务）
# 所以容器用 55432 / 6380 暴露到主机，连容器要走高位端口
DATABASE_URL="postgresql://postgres:postgres123@localhost:55432/agent_platform?schema=public"

# ===== Redis（缓存 + BullMQ 队列）=====
REDIS_HOST=localhost
REDIS_PORT=6380

# ===== 向量库（Qdrant / Milvus 切换）=====
# Qdrant（默认）
QDRANT_URL=http://localhost:6334
# Milvus（启用时填）
MILVUS_ADDRESS=localhost:19530
# 适配器选择：qdrant | milvus
VECTOR_STORE_PROVIDER=qdrant

# ===== JWT 配置 =====
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=please-change-me-to-a-32-char-random-secret-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ===== 默认管理员账号（seed 用）=====
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=123456

# ===== LLM Provider 默认配置（可选）=====
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ===== MiniMax（国际版，sk-cp- 开头的是 com 不是 chat）=====
# 注意：api.minimaxi.com = 国际版（这个 key 是国际版）
#       api.minimaxi.chat = 国内版（用另一套 key）
MINIMAX_API_KEY=sk-cp-H1Pwedvr3l44zRD7yON2FvcdOvKlyfcQKTfL9tOIKwDzGfsp2CXJKzeXoSfrixht_BgtqDIOR64V08y1lrrT4cQ7HnRLA6LbVSSX_Qwu3g5paS_QSg3WkE0
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

# ===== Provider API Key 加密（32 字节 hex，用于 AES-256-GCM）=====
ENCRYPTION_KEY=2c9e8a2259be5719481df17b7c1874357adf0b37a5d5f23978036843419f59a3

# ===== 文件上传 =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100