// AI Agent Platform - Prisma Schema
// 数据库：PostgreSQL 16
// ORM：Prisma 5.x

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 1. 用户 / 认证
// ============================================================

enum UserStatus {
  active
  disabled
  locked
}

model User {
  id                  String     @id @default(cuid())
  username            String     @unique
  passwordHash        String     @map("password_hash")
  name                String
  email               String?    @unique
  avatar              String?
  status              UserStatus @default(active)
  isSuperAdmin        Boolean    @default(false) @map("is_super_admin")
  mustChangePassword  Boolean    @default(false) @map("must_change_password")
  lastLoginAt         DateTime?  @map("last_login_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  userOrganizations   UserOrganization[]
  userRoles           UserRole[]

  @@index([status])
  @@map("users")
}

// ============================================================
// 2. 组织（树形）
// ============================================================

enum OrganizationStatus {
  active
  disabled
}

model Organization {
  id          String             @id @default(cuid())
  parentId    String?            @map("parent_id")
  name        String
  code        String             @unique
  path        String             @default("/") // /1/2/3/ 形式
  level       Int                @default(1)
  sort        Int                @default(0)
  status      OrganizationStatus @default(active)
  description String?
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  parent             Organization?         @relation("OrgTree", fields: [parentId], references: [id])
  children           Organization[]        @relation("OrgTree")
  userOrganizations  UserOrganization[]

  @@index([parentId, sort])
  @@map("organizations")
}

enum DataScope {
  ALL                 // 全部
  ORG                 // 本组织
  ORG_AND_CHILDREN    // 本组织及下级
  SELF                // 仅本人
  CUSTOM              // 自定义（customOrgIds）
}

model UserOrganization {
  id              String     @id @default(cuid())
  userId          String     @map("user_id")
  organizationId  String     @map("organization_id")
  isPrimary       Boolean    @default(false) @map("is_primary")
  dataScope       DataScope  @default(SELF)
  customOrgIds    String[]   @default([]) @map("custom_org_ids") // PostgreSQL 数组；当 dataScope=CUSTOM 时生效
  createdAt       DateTime   @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("user_organizations")
}

// ============================================================
// 3. 角色 / 权限（RBAC）
// ============================================================

model Role {
  id          String     @id @default(cuid())
  code        String     @unique // super_admin / admin / editor / viewer / 自定义
  name        String
  description String?
  isBuiltin   Boolean    @default(false) @map("is_builtin")
  dataScope   DataScope? @map("data_scope") // 角色默认数据范围（用户级可覆盖）
  parentId    String?    @map("parent_id") // 角色继承：自动获得父角色的全部权限
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  parent   Role?  @relation("RoleTree", fields: [parentId], references: [id])
  children Role[] @relation("RoleTree")

  rolePermissions  RolePermission[]
  userRoles        UserRole[]
  fieldPermissions FieldPermission[]

  @@index([parentId])
  @@map("roles")
}

/// 字段级权限：控制某角色读取某资源时，敏感字段是否可见 / 脱敏
model FieldPermission {
  id        String   @id @default(cuid())
  roleId    String   @map("role_id")
  resource  String // 资源标识：user / agent / llm_provider / api_key ...
  field     String // 字段名：email / phone / apiKey ...
  access    String   @default("masked") // masked 脱敏 | hidden 隐藏 | visible 明文
  createdAt DateTime @default(now()) @map("created_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, field])
  @@index([resource])
  @@map("field_permissions")
}

enum PermissionType {
  menu   // 菜单
  button // 按钮
  api    // 接口
}

model Permission {
  id        String         @id @default(cuid())
  code      String         @unique // user:create / agent:publish / ...
  name      String
  type      PermissionType
  parentId  String?        @map("parent_id")
  sort      Int            @default(0)
  createdAt DateTime       @default(now()) @map("created_at")

  parent           Permission?        @relation("PermTree", fields: [parentId], references: [id])
  children         Permission[]       @relation("PermTree")
  rolePermissions  RolePermission[]

  @@index([type, parentId])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  roleId         String   @map("role_id")
  organizationId String?  @map("organization_id") // 角色可限定到组织
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, organizationId])
  @@map("user_roles")
}

// ============================================================
// 4. LLM Provider 配置
// ============================================================

enum LlmProviderType {
  openai          // 官方 OpenAI
  deepseek        // DeepSeek（OpenAI 兼容）
  qwen            // 通义千问（OpenAI 兼容）
  zhipu           // 智谱（OpenAI 兼容）
  MiniMax         // MiniMax（OpenAI 兼容）
  ollama          // 本地 Ollama（OpenAI 兼容）
  anthropic       // Claude
  custom          // 自定义 OpenAI 兼容端点
}

model LlmProvider {
  id              String         @id @default(cuid())
  organizationId  String         @map("organization_id")
  name            String
  providerType    LlmProviderType @map("provider_type")
  baseUrl         String         @map("base_url")
  apiKeyEncrypted String         @map("api_key_encrypted")
  models          String[]       // 支持的模型列表 ["gpt-4", "gpt-3.5-turbo"]
  defaultModel    String?        @map("default_model")
  isDefault       Boolean        @default(false) @map("is_default")
  status          String         @default("active") // active / disabled
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("llm_providers")
}

// ============================================================
// 5. 智能体
// ============================================================

enum AgentType {
  chat       // 聊天智能体
  workflow   // 流程编排智能体
}

enum AgentStatus {
  draft
  published
  archived
}

model Agent {
  id              String      @id @default(cuid())
  organizationId  String      @map("organization_id")
  creatorId       String      @map("creator_id")
  name            String
  type            AgentType
  description     String?
  avatar          String?
  systemPrompt    String      @default("") @map("system_prompt")
  modelConfig     Json        @default("{}") @map("model_config") // { providerId, model, temperature, ... }，仅 chat 类型必填
  workflowId      String?     @map("workflow_id") // 仅 workflow 类型必填：绑定的流程编排工作流
  status          AgentStatus @default(draft)
  publishedVersion Int        @default(0) @map("published_version")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  workflow      Workflow?     @relation("AgentBoundWorkflow", fields: [workflowId], references: [id], onDelete: SetNull)
  versions      AgentVersion[]
  agentSkills   AgentSkill[]
  conversations Conversation[]
  workflows     Workflow[]

  @@index([organizationId, type])
  @@index([creatorId])
  @@index([workflowId])
  @@map("agents")
}

model AgentVersion {
  id          String   @id @default(cuid())
  agentId     String   @map("agent_id")
  version     Int
  configJson  Json     @map("config_json")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, version])
  @@map("agent_versions")
}

// ============================================================
// 6. Skills 工具
// ============================================================

enum SkillType {
  openapi      // OpenAPI Schema 导入
  function     // 自定义 JS 函数
}

model Skill {
  id              String     @id @default(cuid())
  organizationId  String     @map("organization_id")
  creatorId       String     @map("creator_id")
  name            String
  type            SkillType
  description     String?
  status          String     @default("active") // active / disabled
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  versions     SkillVersion[]
  agentSkills  AgentSkill[]
  invocations  ToolInvocation[]

  @@index([organizationId, type])
  @@map("skills")
}

model SkillVersion {
  id              String   @id @default(cuid())
  skillId         String   @map("skill_id")
  version         Int
  schemaJson      Json     @map("schema_json")     // 输入参数 Zod Schema
  sourceCode      String?  @map("source_code")    // function 类型时为 JS 代码
  openapiSchema   Json?    @map("openapi_schema") // openapi 类型时为 OpenAPI 文档
  securityPolicy  Json     @default("{}") @map("security_policy") // { allowedDomains, maxDuration, ... }
  createdAt       DateTime @default(now()) @map("created_at")

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, version])
  @@map("skill_versions")
}

model AgentSkill {
  id        String   @id @default(cuid())
  agentId   String   @map("agent_id")
  skillId   String   @map("skill_id")
  enabled   Boolean  @default(true)
  configJson Json    @default("{}") @map("config_json")
  createdAt DateTime @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([agentId, skillId])
  @@map("agent_skills")
}

// ============================================================
// 7. 知识库 / 文档
// ============================================================

enum DocumentParseStatus {
  pending
  processing
  completed
  failed
}

model KnowledgeBase {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  creatorId       String   @map("creator_id")
  name            String
  description     String?
  embeddingModel  String   @default("text-embedding-3-small") @map("embedding_model")
  embeddingProviderId String? @map("embedding_provider_id") // 选用的模型提供商（LlmProvider.id），用于调用 EmbeddingsService
  retrievalConfig Json     @default("{}") @map("retrieval_config") // { topK, scoreThreshold, reranker }
  status          String   @default("active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  documents Document[]

  @@index([organizationId])
  @@map("knowledge_bases")
}

model Document {
  id              String              @id @default(cuid())
  knowledgeBaseId String              @map("knowledge_base_id")
  uploaderId      String              @map("uploader_id")
  name            String
  originalName    String              @map("original_name")
  mimeType        String              @map("mime_type")
  size            Int
  fileId          String?             @map("file_id") // 对应 files 表
  parseStatus     DocumentParseStatus @default(pending) @map("parse_status")
  pageCount       Int                 @default(0) @map("page_count")
  chunkCount      Int                 @default(0) @map("chunk_count")
  errorMessage    String?             @map("error_message")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks        DocumentChunk[]

  @@index([knowledgeBaseId, parseStatus])
  @@map("documents")
}

model DocumentChunk {
  id          String   @id @default(cuid())
  documentId  String   @map("document_id")
  content     String
  chunkIndex  Int      @map("chunk_index")
  pageNumber  Int?     @map("page_number")
  metadata    Json     @default("{}")
  tokenCount  Int      @default(0) @map("token_count")
  createdAt   DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@map("document_chunks")
}

// ============================================================
// 8. 会话 / 消息
// ============================================================

model Conversation {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  agentId         String?  @map("agent_id")
  workflowId      String?  @map("workflow_id") // 绑工作流对话：每次 send 走工作流引擎
  kbIds           String[] @default([]) @map("kb_ids") // 纯 LLM 知识库问答关联，刷新后仍可恢复
  userId          String   @map("user_id")
  title           String   @default("New Conversation")
  status          String   @default("active") // active / archived
  lastMessageAt   DateTime? @map("last_message_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  agent    Agent?    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workflow Workflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  messages Message[]
  executions Execution[]

  @@index([userId, lastMessageAt])
  @@index([agentId])
  @@index([workflowId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  role           String   // user / assistant / system / tool
  content        String
  contentJson    Json?    @map("content_json")
  toolCalls      Json?    @map("tool_calls")
  attachments    Json?    @map("attachments")
  tokenUsage     Json?    @map("token_usage")
  runId          String?  @map("run_id")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ============================================================
// 9. 工作流 / 执行
// ============================================================

enum WorkflowStatus {
  draft
  published
  archived
}

model Workflow {
  id              String         @id @default(cuid())
  organizationId  String         @map("organization_id")
  creatorId       String         @map("creator_id")
  agentId         String?        @map("agent_id")
  name            String
  description     String?
  graphJson       Json           @map("graph_json") // 节点、边、视口
  status          WorkflowStatus @default(draft)
  version         Int            @default(1)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  agent        Agent?      @relation(fields: [agentId], references: [id], onDelete: SetNull)
  boundAgents  Agent[]     @relation("AgentBoundWorkflow") // workflow 类型智能体反向引用
  executions   Execution[]
  conversations Conversation[]

  @@index([organizationId])
  @@map("workflows")
}

enum ExecutionStatus {
  pending
  running
  success
  failed
  cancelled
}

model Execution {
  id              String          @id @default(cuid())
  organizationId  String          @map("organization_id")
  workflowId      String?         @map("workflow_id")
  agentId         String?         @map("agent_id")
  conversationId  String?         @map("conversation_id")
  userId          String          @map("user_id")
  status          ExecutionStatus @default(pending)
  inputJson       Json?           @map("input_json")
  outputJson      Json?           @map("output_json")
  traceId         String          @unique @map("trace_id")
  errorMessage    String?         @map("error_message")
  startedAt       DateTime?       @map("started_at")
  finishedAt      DateTime?       @map("finished_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  workflow     Workflow?          @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  conversation Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  logs         ExecutionLog[]
  toolInvocations ToolInvocation[]

  @@index([organizationId, status])
  @@index([userId, createdAt])
  @@map("executions")
}

model ExecutionLog {
  id           String   @id @default(cuid())
  executionId  String   @map("execution_id")
  nodeKey      String   @map("node_key")
  eventType    String   @map("event_type")
  payloadJson  Json     @map("payload_json")
  durationMs   Int?     @map("duration_ms")
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt])
  @@map("execution_logs")
}

model ToolInvocation {
  id            String   @id @default(cuid())
  executionId   String   @map("execution_id")
  skillId       String   @map("skill_id")
  agentId       String?  @map("agent_id")      // 智能体调用时填写，便于按智能体筛选
  userId        String?  @map("user_id")       // 调用人 userId
  organizationId String? @map("organization_id") // 冗余存一份便于按组织筛选（避免 join execution）
  inputJson     Json     @map("input_json")
  outputJson    Json?    @map("output_json")
  status        String   @default("pending") // pending / success / failed
  durationMs    Int?     @map("duration_ms")
  errorMessage  String?  @map("error_message")
  createdAt     DateTime @default(now()) @map("created_at")

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([agentId])
  @@index([skillId])
  @@index([userId])
  @@map("tool_invocations")
}

// ============================================================
// 10. 基础设施
// ============================================================

model File {
  id            String   @id @default(cuid())
  organizationId String  @map("organization_id")
  uploaderId    String   @map("uploader_id")
  storageKey    String   @unique @map("storage_key")
  originalName  String   @map("original_name")
  mimeType      String   @map("mime_type")
  size          Int
  checksum      String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("files")
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  creatorId      String    @map("creator_id")
  name           String
  keyHash        String    @unique @map("key_hash")
  keyPrefix      String    @map("key_prefix") // 用于识别（"ak_abc123..."）
  scopes         String[]  @default([])
  lastUsedAt     DateTime? @map("last_used_at")
  expiresAt      DateTime? @map("expires_at")
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("api_keys")
}

model AuditLog {
  id            String   @id @default(cuid())
  organizationId String? @map("organization_id")
  userId        String?  @map("user_id")
  action        String   // login / create_agent / delete_kb / ...
  resourceType  String   @map("resource_type")
  resourceId    String?  @map("resource_id")
  detailJson    Json     @default("{}") @map("detail_json")
  ip            String?
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}