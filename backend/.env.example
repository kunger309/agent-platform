# ===== 服务器配置 =====
NODE_ENV=development
PORT=3000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:5173

# ===== 数据库（PostgreSQL）=====
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/agent_platform?schema=public

# ===== Redis（缓存 + BullMQ 队列）=====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== 向量库（Qdrant / Milvus 切换）=====
# Qdrant（默认）
QDRANT_URL=http://localhost:6333
# Milvus（启用时填）
MILVUS_ADDRESS=localhost:19530
# 适配器选择：qdrant | milvus
VECTOR_STORE_PROVIDER=qdrant

# ===== JWT 配置 =====
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=please-change-me-to-a-32-char-random-secret-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ===== 默认管理员账号（seed 用）=====
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=123456

# ===== LLM Provider 默认配置（可选）=====
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ===== 文件上传 =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100