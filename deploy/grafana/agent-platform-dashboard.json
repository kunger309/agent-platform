{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "抓取 agent-platform /api/metrics 的 Prometheus 数据源",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Agent Platform 运行监控",
  "uid": "agent-platform-main",
  "tags": ["agent-platform", "nestjs", "llm"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "数据源"
      },
      {
        "name": "app",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(agentx_http_requests_total, app)",
        "current": { "text": "agent-platform", "value": "agent-platform" },
        "refresh": 1,
        "includeAll": false,
        "label": "实例"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "服务概览",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "QPS（近 5 分钟）",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(agentx_http_requests_total{app=\"$app\"}[5m]))",
          "legendFormat": "QPS"
        }
      ]
    },
    {
      "type": "stat",
      "title": "错误率（5xx）",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(agentx_http_requests_total{app=\"$app\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(agentx_http_requests_total{app=\"$app\"}[5m])), 0.0001)",
          "legendFormat": "错误率"
        }
      ]
    },
    {
      "type": "stat",
      "title": "P95 响应耗时",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(agentx_http_request_duration_seconds_bucket{app=\"$app\"}[5m])))",
          "legendFormat": "P95"
        }
      ]
    },
    {
      "type": "stat",
      "title": "并发请求数",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(agentx_http_in_flight_requests{app=\"$app\"})",
          "legendFormat": "in-flight"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Embedding 缓存命中率",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "green", "value": 0.6 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(agentx_embedding_requests_total{app=\"$app\",cache=\"hit\"}[30m])) / clamp_min(sum(rate(agentx_embedding_requests_total{app=\"$app\"}[30m])), 0.0001)",
          "legendFormat": "命中率"
        }
      ]
    },
    {
      "type": "stat",
      "title": "进程运行时长",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - agentx_node_process_start_time_seconds{app=\"$app\"}",
          "legendFormat": "uptime"
        }
      ]
    },

    {
      "type": "row",
      "title": "HTTP 接口",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "请求速率（按状态码）",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 20, "lineWidth": 1, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "calcs": ["mean", "max"], "placement": "right" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(agentx_http_requests_total{app=\"$app\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "耗时分位（P50 / P95 / P99）",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 8, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(agentx_http_request_duration_seconds_bucket{app=\"$app\"}[5m])))",
          "legendFormat": "P50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(agentx_http_request_duration_seconds_bucket{app=\"$app\"}[5m])))",
          "legendFormat": "P95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(agentx_http_request_duration_seconds_bucket{app=\"$app\"}[5m])))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "type": "table",
      "title": "最慢路由 TOP 10（P95）",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3 }, "overrides": [] },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, route, method) (rate(agentx_http_request_duration_seconds_bucket{app=\"$app\"}[30m]))))"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "Value": "P95 耗时", "route": "路由", "method": "方法" } } }
      ]
    },

    {
      "type": "row",
      "title": "LLM / 工作流 / 技能",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "LLM 调用速率（按模型）",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, status) (rate(agentx_llm_requests_total{app=\"$app\"}[5m]))",
          "legendFormat": "{{model}} · {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM 调用耗时 P95（按模型）",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 8 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(agentx_llm_request_duration_seconds_bucket{app=\"$app\"}[10m])))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "工作流执行（成功 / 失败）",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "error" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "success" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(agentx_workflow_runs_total{app=\"$app\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "技能调用速率（按技能）",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (skill_id, status) (increase(agentx_skill_invocations_total{app=\"$app\"}[5m])))",
          "legendFormat": "{{skill_id}} · {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "技能调用耗时 P95",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 8 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, skill_id) (rate(agentx_skill_invocation_duration_seconds_bucket{app=\"$app\"}[10m])))",
          "legendFormat": "{{skill_id}}"
        }
      ]
    },

    {
      "type": "row",
      "title": "对外 API（API Key）",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "对外调用速率（按端点）",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 41 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (endpoint) (rate(agentx_api_key_calls_total{app=\"$app\"}[5m]))",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "type": "table",
      "title": "API Key 调用量 TOP 10（近 1 小时）",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 41 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "topk(10, sum by (key_id, status) (increase(agentx_api_key_calls_total{app=\"$app\"}[1h])))"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "Value": "调用次数", "key_id": "密钥 ID", "status": "状态" } } }
      ]
    },

    {
      "type": "row",
      "title": "缓存与资源",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 49 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Embedding 请求（命中 / 未命中）",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 50 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "hit" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "miss" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cache) (increase(agentx_embedding_requests_total{app=\"$app\"}[5m]))",
          "legendFormat": "{{cache}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "平台实体存量",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 50 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 5, "lineWidth": 2 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "agentx_entity_total{app=\"$app\"}",
          "legendFormat": "{{entity}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Node 进程内存 / 事件循环延迟",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 50 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 8 } }, "overrides": [
        { "matcher": { "id": "byName", "options": "事件循环 P99" }, "properties": [{ "id": "unit", "value": "s" }, { "id": "custom.axisPlacement", "value": "right" }] }
      ] },
      "targets": [
        {
          "refId": "A",
          "expr": "agentx_node_process_resident_memory_bytes{app=\"$app\"}",
          "legendFormat": "RSS"
        },
        {
          "refId": "B",
          "expr": "agentx_node_nodejs_heap_size_used_bytes{app=\"$app\"}",
          "legendFormat": "堆已用"
        },
        {
          "refId": "C",
          "expr": "agentx_node_nodejs_eventloop_lag_p99_seconds{app=\"$app\"}",
          "legendFormat": "事件循环 P99"
        }
      ]
    }
  ]
}
